{"url_public_html": "https://figshare.com/articles/dataset/A_multi-sensor_and_cross-session_human_gait_dataset_captured_through_an_optical_system_and_inertial_measurement_units/14727231/7", "files": [{"id": 35882624, "name": "A multi-sensor human gait dataset.zip", "size": 1523321221, "is_link_only": false, "download_url": "https://ndownloader.figshare.com/files/35882624", "supplied_md5": "35adf0860202f2aefa37560dc0748ebd", "computed_md5": "35adf0860202f2aefa37560dc0748ebd", "mimetype": "application/zip"}], "folder_structure": {}, "authors": [{"id": 10918539, "full_name": "Geise Santos", "first_name": "Geise", "last_name": "Santos", "is_active": true, "url_name": "Geise_Santos", "orcid_id": ""}, {"id": 4904089, "full_name": "Marcelo M. Wanderley", "first_name": "Marcelo M.", "last_name": "Wanderley", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 10918548, "full_name": "Tiago tavares", "first_name": "Tiago", "last_name": "tavares", "is_active": false, "url_name": "_", "orcid_id": "0000-0002-9104-613X"}, {"id": 8390854, "full_name": "Anderson Rocha", "first_name": "Anderson", "last_name": "Rocha", "is_active": false, "url_name": "_", "orcid_id": ""}], "custom_fields": [], "figshare_url": "https://figshare.com/articles/dataset/A_multi-sensor_and_cross-session_human_gait_dataset_captured_through_an_optical_system_and_inertial_measurement_units/14727231", "download_disabled": false, "description": "This multi-sensor gait dataset comprises inertial and optical motion data from 25 subjects free of lower-limb injury, aged between 18 and 47 years. A smartphone and an IMU were attached to one of the subject's legs to capture accelerometer data, and 42 reflexive markers were taped over the whole body to record three-dimensional trajectories. The participants were instructed to walk on a straight-level walkway at their normal pace.  Ten trials for each participant were recorded and preprocessed in each of two sessions, performed on different days. This amounts to 500 trials of three-dimensional trajectories, 500 trials of accelerations from the IMU, and 500 trials of accelerations from the smartphone.", "funding": null, "funding_list": [], "version": 7, "status": "public", "size": 1523321221, "created_date": "2022-06-14T22:12:45Z", "modified_date": "2022-06-14T22:12:46Z", "is_public": true, "is_confidential": false, "is_metadata_record": false, "confidential_reason": "", "metadata_reason": "", "license": {"value": 1, "name": "CC BY 4.0", "url": "https://creativecommons.org/licenses/by/4.0/"}, "tags": ["gait analysis", "human motion", "multi sensor data", "accelerometer sensors", "optical motion capture", "mocap", "Human Movement and Sports Science not elsewhere classified", "Biomechanical Engineering"], "keywords": ["gait analysis", "human motion", "multi sensor data", "accelerometer sensors", "optical motion capture", "mocap", "Human Movement and Sports Science not elsewhere classified", "Biomechanical Engineering"], "categories": [{"id": 27220, "title": "Sports science and exercise not elsewhere classified", "parent_id": 27208, "path": "/27001/27208/27220", "source_id": "420799", "taxonomy_id": 100}, {"id": 26272, "title": "Biomechanical engineering", "parent_id": 26263, "path": "/26212/26263/26272", "source_id": "400303", "taxonomy_id": 100}], "references": [], "has_linked_file": false, "citation": "Santos, Geise; Wanderley, Marcelo M.; tavares, Tiago; Rocha, Anderson (2021). A multi-sensor human gait dataset captured through an optical system and inertial measurement units. figshare. Dataset. https://doi.org/10.6084/m9.figshare.14727231.v7", "related_materials": [], "is_embargoed": false, "embargo_date": null, "embargo_type": "file", "embargo_title": "", "embargo_reason": "", "embargo_options": [], "id": 14727231, "title": "A multi-sensor human gait dataset captured through an optical system and inertial measurement units", "doi": "10.6084/m9.figshare.14727231.v7", "handle": "", "url": "https://api.figshare.com/v2/artic